# tap-microsoft-graph example env vars.
#
# Meltano picks these up automatically when running `meltano invoke tap-microsoft-graph`
# from this directory. NEVER commit the populated .env — only this .example
# file ships with the repo.
#
# Production values live in:
#   - Dagster+ deployment env vars (for the deployed pipeline), and
#   - Azure Key Vault `kv-vertex-write` (for the source of truth secret).

# Azure AD app registration client ID (GUID, not secret).
TAP_MICROSOFT_GRAPH_CLIENT_ID=

# Azure AD app registration client secret. Rotate via az ad app credential reset.
TAP_MICROSOFT_GRAPH_CLIENT_SECRET=

# Azure AD tenant ID (GUID). For Vertex this is 7347cab8-505e-48be-9216-fdc3a082fb4b.
TAP_MICROSOFT_GRAPH_TENANT_ID=

# User principal name (or object id) of the shared mailbox to read.
# For the Marketing Spend Agent: marketingagent@vertexservicepartners.com
TAP_MICROSOFT_GRAPH_SHARED_MAILBOX_ID=

# Graph API root. /v1.0 in prod; /beta only when you need beta-only fields.
TAP_MICROSOFT_GRAPH_API_URL=https://graph.microsoft.com/v1.0

# Earliest receivedDateTime to sync on the first run.
TAP_MICROSOFT_GRAPH_START_DATE=2024-01-01T00:00:00Z

# Toggle the Snowflake-stage PUT side-channel for attachments. Keep false
# until the @ARCH_RAW.OUTLOOK_MARKETING_INBOX.MARKETING_EMAIL_ATTACHMENTS
# stage exists.
TAP_MICROSOFT_GRAPH_STAGE_UPLOAD_ENABLED=false
